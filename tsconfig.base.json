// Shared type-check flags for every project in the repo (`tsc -b` from the
// root `tsconfig.json` solution file drives them all). Emit/library flags
// live in `tsconfig.lib.json`; each project sets its own `lib`/`types`.
{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext.disposable"
    ],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
