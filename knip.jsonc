// knip — unused files / dependencies / exports gate (CLEANUP-PLAN §7.5).
// Runs as `npm run knip` inside `npm run check`. Plain `knip`, not `--strict`:
// knip 6's strict mode is a workspace-isolated, direct-production-deps-only
// analysis that (a) stops reporting unused files/exports and (b) misattributes
// npm-hoisted workspace dependencies (`smol-toml` in packages/node showed up
// as unused) — measured 2026-09-14.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // No `ignore` block: the generated `*.gen.ts` files are imported (so never
  // reported) and vendor/, context/ and the corpus hold no analysable source;
  // knip flags such entries as redundant configuration hints.
  "ignoreDependencies": [
    // Phase 4 (§8) configures these ESLint plugins; Phase 1 pinned and
    // installed them so the lockfile settles early. Remove from this list
    // as eslint.config.js starts importing each one.
    "@vitest/eslint-plugin",
    "eslint-config-prettier",
    "eslint-plugin-import-x",
    "eslint-plugin-jsdoc",
    "eslint-plugin-n",
    "eslint-plugin-regexp",
    "eslint-plugin-tsdoc",
    "eslint-plugin-unicorn",
    "globals",
  ],
  "rules": {
    // Phase 6 (§2.7 un-export sweep) turns these back to "error". Until
    // then the 145 unused exports / 126 unused types it will remove are
    // reported as warnings so the gate stays green and the list stays live.
    "exports": "warn",
    "types": "warn",
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.mjs", "tests/**/*.ts"],
    },
    "packages/core": {
      // `src/index.ts` and `src/internal.ts` are inferred from `exports`.
      "project": ["src/**/*.ts", "test/**/*.ts", "test-support/**/*.ts"],
    },
    "packages/node": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/browser": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "conformance-runner": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "differential": {
      "entry": ["oracle/main.ts", "src/index.ts"],
      "project": [
        "src/**/*.ts",
        "oracle/**/*.ts",
        "referees/**/*.ts",
        "test/**/*.ts",
      ],
    },
  },
}
