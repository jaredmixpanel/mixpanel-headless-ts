{
  "name": "mixpanel-headless-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the Python mixpanel_headless library: typed Mixpanel analytics queries, entity management, and data extraction for Node.js and browsers, verified against a Python-extracted conformance corpus.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredmixpanel/mixpanel-headless-ts.git"
  },
  "keywords": [
    "mixpanel",
    "analytics",
    "typescript",
    "headless",
    "api-client",
    "monorepo"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "workspaces": [
    "packages/*",
    "conformance-runner",
    "differential"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "referee:bookmark": "vitest run differential/test/bookmark-schema-referee.test.ts differential/test/bookmark-referee-feed.test.ts",
    "generate:error-codes": "node scripts/gen-error-codes.mjs",
    "vendor:drift": "bash scripts/check-vendor-drift.sh",
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run test && npm run smoke:browser",
    "sync:corpus": "bash scripts/sync-corpus.sh",
    "conformance": "node scripts/run-conformance.mjs",
    "oracle": "node scripts/run-oracle.mjs",
    "generate:api-map": "node scripts/generate-api-map.mjs",
    "generate:bridge-allowlist": "node scripts/generate-bridge-allowlist.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.6",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.0.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.24",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": false
  }
}
