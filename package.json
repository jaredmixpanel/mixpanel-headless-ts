{
  "name": "mixpanel-headless-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the Python mixpanel_headless library: typed Mixpanel analytics queries, entity management, and data extraction for Node.js and browsers, verified against a Python-extracted conformance corpus.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredmixpanel/mixpanel-headless-ts.git"
  },
  "keywords": [
    "mixpanel",
    "analytics",
    "typescript",
    "headless",
    "api-client",
    "monorepo"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "workspaces": [
    "packages/*",
    "conformance-runner",
    "differential"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "pack:check": "publint --strict packages/core && publint --strict packages/node && publint --strict packages/browser && attw --pack packages/core --profile esm-only && attw --pack packages/node --profile esm-only && attw --pack packages/browser --profile esm-only",
    "knip": "knip",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "test:fast": "vitest run --project '!corpus'",
    "test:corpus": "vitest run --project corpus",
    "test:coverage": "vitest run --coverage",
    "referee:bookmark": "vitest run differential/test/bookmark-schema-referee.test.ts differential/test/bookmark-referee-feed.test.ts",
    "generate:error-codes": "node scripts/generate-error-codes.mjs",
    "generate:demo-fixtures": "node scripts/generate-demo-fixtures.mjs",
    "vendor:drift": "bash scripts/check-vendor-drift.sh",
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "demo:canary": "node scripts/demo-canary.mjs",
    "version": "changeset version",
    "release": "changeset publish",
    "check": "npm run typecheck && npm run pack:check && npm run knip && npm run lint && npm run docs:api:check && npm run fmt:check && npm run audit:comments -- --summary && npm run vendor:drift && npm run test:coverage && npm run smoke:browser",
    "sync:corpus": "bash scripts/sync-corpus.sh",
    "conformance": "node scripts/run-conformance.mjs",
    "oracle": "node scripts/run-oracle.mjs",
    "generate:api-map": "node scripts/generate-api-map.mjs",
    "generate:bridge-allowlist": "node scripts/generate-bridge-allowlist.mjs",
    "generate:compat-tables": "uv run --python 3.14.6 --no-project python scripts/generate-non-printable.py && uv run --python 3.14.6 --no-project python scripts/generate-decimal-digits.py && uv run --python 3.14.6 --no-project python scripts/generate-whitespace.py",
    "generate:python-anchors": "node scripts/generate-python-reference-anchors.mjs",
    "generate:canonical-fixtures": "uv run --python 3.14.6 --no-project python scripts/generate-canonical-fixtures.py && prettier --write packages/core/test/compat/fixtures/canonical-fixtures.json",
    "generate:all": "npm run generate:error-codes && npm run generate:api-map && npm run generate:bridge-allowlist",
    "audit:comments": "node scripts/audit/comment-archaeology.mjs",
    "audit:comments:fix": "node scripts/audit/comment-archaeology.mjs --fix",
    "docs:api": "typedoc",
    "docs:api:check": "typedoc --emit none --treatWarningsAsErrors",
    "docs:dev": "npm run build && npm run docs:api && vitepress dev docs",
    "docs:build": "npm run build && npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@mixpanel-headless/browser": "*",
    "@mixpanel-headless/core": "*",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/twoslash": "^4.4.3",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.6",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.0.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.0.0",
    "publint": "^0.3.24",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "~1.6.4",
    "vitepress-plugin-llms": "^1.13.5",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^5.0.0",
    "vue": "^3.5.13"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "fsevents": false,
    "unrs-resolver": false
  }
}
