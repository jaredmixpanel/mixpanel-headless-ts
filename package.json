{
  "name": "mixpanel-headless-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of mixpanel_headless (Phase 1 verification rig scaffold).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "conformance-runner",
    "differential"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run test && npm run smoke:browser"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.43",
    "ajv": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
