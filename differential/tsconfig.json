{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // DOM libs: the oracle imports the conformance runner, whose fetch
    // harness uses typing names (BodyInit, ReadableWritablePair) that
    // @types/node does not expose as globals.
    "lib": [
      "es2023",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext.disposable"
    ],
    "types": ["node"]
  },
  "include": ["src", "test", "referees", "oracle"],
  "references": [{ "path": "../packages/core" }]
}
