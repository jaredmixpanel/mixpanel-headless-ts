engine-strict=true
save-exact=false
# A release must be at least a week old before npm resolves to it — the same
# cooldown Dependabot applies (.github/dependabot.yml), so a local install and
# a Dependabot PR never disagree. Read by npm >= 11.6 (Node 24); older npm
# prints an "Unknown project config" warning and ignores it.
min-release-age=7
fund=false
